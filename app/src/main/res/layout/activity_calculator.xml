<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_bg">

    <!-- Header at the top -->
    <include layout="@layout/header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quote Calculator"
                android:textColor="@color/my_blue"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select your courses to see the discount:"
                android:layout_marginTop="10dp" />

            <!-- 6-Month Courses -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Professional Courses (R1500 each):"
                android:textStyle="bold"
                android:layout_marginTop="20dp"/>

            <CheckBox android:id="@+id/check_c1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Canine Obedience Training"/>
            <CheckBox android:id="@+id/check_c2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pet Grooming"/>
            <CheckBox android:id="@+id/check_c3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Animal Behaviour"/>
            <CheckBox android:id="@+id/check_c4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pet Business Management"/>

            <!-- 6-Week Courses -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Short Courses (R750 each):"
                android:textStyle="bold"
                android:layout_marginTop="15dp"/>

            <CheckBox android:id="@+id/check_c5" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Puppy Care"/>
            <CheckBox android:id="@+id/check_c6" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pet First Aid"/>
            <CheckBox android:id="@+id/check_c7" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Basic Dog Walking"/>

            <Button
                android:id="@+id/btn_calculate_now"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Calculate My Total"
                android:backgroundTint="@color/my_blue"
                android:textColor="@color/white"/>

            <!-- Display Area for results -->
            <TextView
                android:id="@+id/txt_total_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="15dp"
                android:background="#FFFFFF"
                android:text="Total will appear here..."
                android:textSize="18sp"
                android:textColor="@color/dark_navy"
                android:gravity="center" />

            <Button
                android:id="@+id/btn_go_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Request Professional Quote"
                android:backgroundTint="@color/dark_navy"
                android:textColor="@color/white"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>