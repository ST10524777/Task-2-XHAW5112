<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header at the top -->
    <include layout="@layout/header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to"
            android:textColor="@color/pure_black"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pawsitive Pet Academy"
            android:textColor="@color/my_blue"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="5dp" />

        <!-- Actual Logo Image View -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_margin="30dp"
            app:cardCornerRadius="90dp"
            app:cardBackgroundColor="@color/white"
            app:strokeColor="@color/my_blue"
            app:strokeWidth="4dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/logo"
                android:scaleType="centerInside"
                android:padding="20dp"
                android:contentDescription="Pawsitive Pet Academy Logo" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caring, Trustworthy &amp; Professional"
            android:textColor="@color/dark_navy"
            android:textSize="16sp"
            android:layout_marginBottom="30dp"/>

        <Button
            android:id="@+id/btn_start_journey"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Enter the Academy"
            android:backgroundTint="@color/my_blue"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>